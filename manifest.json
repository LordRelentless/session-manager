{
	"manifest_version": 3,
	"name": "Session Manager",
	"version": "3.6.0",
	"description": "Simple yet powerful tab set management. Quickly and easily save, update, remove, and restore sets of tabs!",
	"icons": {
		"16": "img/16.png",
		"128": "img/128.png"
	},
	"action": {
		"default_icon": {
			"19": "img/19-1x.png",
			"38": "img/19-2x.png"
		},
		"default_title": "Session Manager",
		"default_popup": "popup.html"
	},
	"background": {
		"service_worker": "js/background-chrome-mv3.js"
	},
	"omnibox": {
		"keyword": "session"
	},
	"options_page": "options.html",
	"options_ui": {
		"page": "options.html"
	},
	"permissions": ["tabs", "omnibox", "storage"],
	"content_security_policy": {
		"extension_pages": "script-src 'self'; object-src 'self'"
	}
}
